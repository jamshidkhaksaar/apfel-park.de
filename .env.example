# Local PostgreSQL and admin auth
DATABASE_URL="postgresql://apfel_park_app:CHANGE_ME@127.0.0.1:5432/apfel_park"
APP_SESSION_SECRET="replace-with-long-random-secret"
ADMIN_EMAILS="info@apfel-park.de"
ADMIN_PASSWORD="replace-with-strong-admin-password"
UPLOADS_DIR="/srv/apfel-park/app/shared/uploads"
SITE_URL="https://apfel-park.de"
MARKETPLACE_TOKEN_ENCRYPTION_KEY="replace-with-32-random-bytes-in-base64"

# eBay seller integration. RuName values are generated by the eBay developer portal.
EBAY_CLIENT_ID="replace-with-production-client-id"
EBAY_CLIENT_SECRET="replace-with-production-client-secret"
EBAY_DEV_ID="replace-with-production-dev-id"
EBAY_RUNAME="replace-with-production-runame"
EBAY_SANDBOX_CLIENT_ID="replace-with-sandbox-client-id"
EBAY_SANDBOX_CLIENT_SECRET="replace-with-sandbox-client-secret"
EBAY_SANDBOX_DEV_ID="replace-with-sandbox-dev-id"
EBAY_SANDBOX_RUNAME="replace-with-sandbox-runame"
EBAY_NOTIFICATION_ENVIRONMENT="production"
EBAY_NOTIFICATION_ENDPOINT="https://apfel-park.de/api/webhooks/marketplaces/ebay_de"
EBAY_NOTIFICATION_VERIFICATION_TOKEN="replace-with-32-to-80-random-allowed-characters"

# Email notifications (SMTP)
CONTACT_NOTIFICATION_EMAIL="support@your-domain.com"
REPAIRS_NOTIFICATION_EMAIL="repairs@your-domain.com"
SMTP_HOST="mail.your-domain.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="repairs@your-domain.com"
SMTP_PASS="replace-with-strong-smtp-password"
SMTP_FROM_EMAIL="repairs@your-domain.com"

# Google Maps (Embed API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Checkout and payments
PAYMENT_MODE="sandbox"
SHOP_CURRENCY="EUR"
SHOP_VAT_RATE="19"
SHOP_GERMANY_SHIPPING_AMOUNT="6.90"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace"
STRIPE_SECRET_KEY="sk_test_replace"
STRIPE_WEBHOOK_SECRET="whsec_replace"
PAYPAL_CLIENT_ID="replace-with-sandbox-client-id"
PAYPAL_CLIENT_SECRET="replace-with-sandbox-client-secret"
PAYPAL_WEBHOOK_ID="replace-with-webhook-id"
