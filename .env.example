# Supabase Configuration
# Get these from your Supabase project dashboard

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Admin Access Control
# Comma-separated list of emails that are allowed to access the admin panel.
# REQUIRED: If not set, no one will be able to access the admin panel unless they have the 'admin' role.
ADMIN_EMAILS="admin@example.com,developer@example.com"

# Email notifications (Resend)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Apfel Park <no-reply@your-domain.com>"
# Optional fallback recipient if settings.general.email is empty
CONTACT_NOTIFICATION_EMAIL="support@your-domain.com"

# Google Maps (Embed API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Vercel Blob (Product image storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
