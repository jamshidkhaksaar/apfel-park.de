[Unit]
Description=Apfel Park Telegram product research and photo worker
After=network.target postgresql.service apfel-intake-vision.service

[Service]
Type=simple
User=root
WorkingDirectory=/srv/apfel-park/app/current
EnvironmentFile=/srv/apfel-park/app/shared/app.env
Environment=PATH=/root/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/.nvm/versions/node/v24.14.0/bin/node --import=tsx /srv/apfel-park/app/current/scripts/telegram-product-worker.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/apfel-intake/private/telegram /srv/apfel-park/app/shared/uploads
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
