NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
DATABASE_URL=postgresql://apfel:CHANGE_ME@127.0.0.1:5432/apfel_park
APP_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
APP_SECURE_COOKIES=true
ADMIN_EMAILS=admin@apfel-park.de
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
UPLOADS_DIR=/srv/apfel-park/app/shared/uploads
SITE_URL=https://apfel-park.de
MARKETPLACE_TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_RANDOM_BYTES_BASE64

# eBay seller integration. Never commit real credentials or OAuth tokens.
EBAY_CLIENT_ID=CHANGE_ME_PRODUCTION_CLIENT_ID
EBAY_CLIENT_SECRET=CHANGE_ME_PRODUCTION_CLIENT_SECRET
EBAY_DEV_ID=CHANGE_ME_PRODUCTION_DEV_ID
EBAY_RUNAME=CHANGE_ME_PRODUCTION_RUNAME
EBAY_SANDBOX_CLIENT_ID=CHANGE_ME_SANDBOX_CLIENT_ID
EBAY_SANDBOX_CLIENT_SECRET=CHANGE_ME_SANDBOX_CLIENT_SECRET
EBAY_SANDBOX_DEV_ID=CHANGE_ME_SANDBOX_DEV_ID
EBAY_SANDBOX_RUNAME=CHANGE_ME_SANDBOX_RUNAME
EBAY_NOTIFICATION_ENVIRONMENT=production
EBAY_NOTIFICATION_ENDPOINT=https://apfel-park.de/api/webhooks/marketplaces/ebay_de
EBAY_NOTIFICATION_VERIFICATION_TOKEN=CHANGE_ME_32_TO_80_ALLOWED_CHARACTERS
CONTACT_NOTIFICATION_EMAIL=info@apfel-park.de
REPAIRS_NOTIFICATION_EMAIL=repairs@apfel-park.de
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_SECURE=false
