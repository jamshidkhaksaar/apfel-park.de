# Copy to /etc/hermes-notify-bridge.env and replace the placeholder.
#
# BRIDGE_TOKEN is the only variable this file provides. The unit passes the rest
# of the bridge's environment itself: HOME=/root and
# BIND_ADDRS=127.0.0.1,172.23.0.1,172.17.0.1.
#
# The same secret has a second name on the calling side: the n8n container holds
# it as NOTIFY_BRIDGE_TOKEN, and the generated workflows send it as the
# X-Bridge-Token header (deployment/vps/product-intake/n8n/build_workflows.py).
# Rotate both sides together -- rewrite this file, restart hermes-notify-bridge,
# then restart n8n with the matching value -- or every notify call starts failing
# with an auth error.
#
# Keep the file root-owned, group root, mode 0600. It is on the
# Excluded-secrets list in ../README.md and is never committed.
BRIDGE_TOKEN=replace-with-the-shared-n8n-token
