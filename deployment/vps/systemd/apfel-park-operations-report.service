[Unit]
Description=Apfel Park daily, weekly and monthly in-shop sales report
After=network-online.target postgresql.service apfel-park-nextjs.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/apfel-park/app/current
EnvironmentFile=/srv/apfel-park/app/shared/app.env
Environment=PATH=/root/.nvm/versions/node/v24.14.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/srv/apfel-park/app/current/node_modules/.bin/tsx /srv/apfel-park/app/current/scripts/operations-report.ts --period=auto
StandardOutput=journal
StandardError=journal
